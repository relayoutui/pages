---
// Replaces Starlight's site title with the lockup the other product docs use: the mark at 24px, the
// word, then the section label. The lockup goes to Relayout's home page (../www, at /), and the
// label to the docs home, so either is one click from any docs page.
import mark from '../assets/relayout-mark.svg';
import buildInfo from '../build-info.json';

const { siteTitleHref } = Astro.locals.starlightRoute;

// The Relayout version the previews run and the revision of this build, like v0.8.0-r1116.2. Both come from
// scripts/build-info.mjs, and either is left out when it is not known.
const { version, revision } = buildInfo;
const release = version ? `v${version}` : '';
const detail = [
    version && `Docs for Relayout ${version}, the version the examples run`,
    revision && `Docs revision ${revision}`,
].filter(Boolean).join('. ');
---

<div class="brand">
    <a href="/" class="site-title">
        <img src={mark.src} width={mark.width} height={mark.height} alt="" />
        <span class="word" translate="no">Relayout</span>
    </a>
    <a href={siteTitleHref} class="label">Docs</a>
    {(release || revision) && <span class="stamp" title={detail}>{release}{revision && <span class="rev">{release && '-'}{revision}</span>}</span>}
</div>

<style>
    .brand {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-width: 0;
    }
    /* The same structure as authstack.id's .nav-logo: the gap is 0.42em of the link's own text size,
       and the word sets its own 1.125rem below. The mark is a little taller than the cap height so
       it leads the pair. The word is in the system sans, as on the other docs, until a wordmark face is chosen. */
    .site-title {
        display: flex;
        align-items: center;
        gap: 0.42em;
        color: var(--sl-color-white);
        text-decoration: none;
        white-space: nowrap;
    }
    img {
        height: 24px;
        width: auto;
        flex: none;
    }
    .word {
        font-family: var(--sl-font-system);
        font-weight: 600;
        font-size: 1.125rem;
        line-height: 1;
    }
    /* Turns the brand magenta on hover, like the header's icons, since it is a link. */
    .label {
        padding-inline-start: 1rem;
        border-inline-start: 1px solid var(--sl-color-gray-5);
        color: var(--sl-color-white);
        font-size: 0.875rem;
        letter-spacing: 0.08em;
        text-decoration: none;
        text-transform: uppercase;
        white-space: nowrap;
        transition: color 0.15s;
    }
    .label:hover {
        color: var(--brand-text);
    }
    /* Quiet: it is for whoever wants to know which version the examples run and how recent the build is. */
    .stamp {
        color: var(--sl-color-gray-2);
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        cursor: default;
    }
    /* The revision, the "-r1116.2" after the version, is smaller: it is there for whoever looks for it. */
    .rev {
        font-size: 0.625rem;
    }
    /* Below 360px the label would crowd the search button, so it gives way. */
    @media (max-width: 22.49rem) {
        .label {
            display: none;
        }
    }
    /* The stamp goes before it would meet the search box. */
    @media (max-width: 64rem) {
        .stamp {
            display: none;
        }
    }
</style>
