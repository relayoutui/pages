---
// Replaces Starlight's social links with the header links of the other product docs (lpdf.io's
// lang-links.astro): the package on npm and the repository on GitHub, each opening in a new tab,
// with icons a quarter larger than Starlight's. Starlight renders this in the header and again in
// the phone menu.
import { Icon } from '@astrojs/starlight/components';

const LINKS = [
    { label: 'GitHub', href: 'https://github.com/relayoutui/relayout', icon: 'github' },
    { label: 'npm', href: 'https://www.npmjs.com/package/@relayoutui/relayout', icon: 'npm' },
] as const;
---

<relayout-social-links>
    {
        LINKS.map(({ label, href, icon }) => (
            <a href={href} title={label} target="_blank" rel="noopener noreferrer">
                <span class="sr-only">{label}</span>
                <Icon name={icon} class="mark" />
            </a>
        ))
    }
</relayout-social-links>

<style>
    /* The same look as the theme toggle: secondary text colour at rest, the brand magenta on hover.
       The margin opens the gap before the divider that separates the links from the theme toggle. */
    relayout-social-links {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin-inline-end: 0.25rem;
    }
    a {
        display: flex;
        padding: 0.5em;
        margin: -0.5em;
        color: var(--sl-color-gray-2);
        transition: color 0.15s;
    }
    a:hover {
        color: var(--brand-text);
    }
    /* A quarter larger than Starlight's 1em social icons. */
    .mark {
        width: 1.25em;
        height: 1.25em;
    }
</style>
